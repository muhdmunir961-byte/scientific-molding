# ------------------------------------------------------------------
# Scientific Molding Training Series — environment template
# ------------------------------------------------------------------
# Copy to `.env.local` and fill in:
#
#   cp .env.local.example .env.local
#
# `.env.local` is gitignored. NEVER commit real credentials.
# ------------------------------------------------------------------

# --- Resend (transactional email) ----------------------------------
# Get a key at https://resend.com/api-keys
#
# LEAVE THIS EMPTY TO RUN IN TEST MODE. With no key:
#   - POST /api/contact logs the payload and a preview of both emails
#     to the server console
#   - the route still returns success, so the whole form flow is testable
#   - nothing is sent and no key is needed
#
# In production a missing key is FATAL: the route returns 500 rather than
# accepting an enquiry it cannot deliver. That is deliberate — silently
# swallowing a real lead is worse than a visible failure.
RESEND_API_KEY=

# --- Where enquiries are delivered ---------------------------------
# Falls back to the PRD 5.6 address when unset.
CONTACT_EMAIL=hafiedzzul@gmail.com

# --- Site ----------------------------------------------------------
# Used for absolute links in email bodies. Set this in production so
# links in the auto-reply resolve to the live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:5555

# ------------------------------------------------------------------
# Admin panel  (/admin)
# ------------------------------------------------------------------
# The panel is at /admin and is protected by ADMIN_PASSWORD.
#
# WITHOUT ADMIN_PASSWORD the panel refuses every login. It does not
# fall open — an unset variable must never mean "no password required".
#
# Generate a long random value, e.g.:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Signs the session cookie. Optional; falls back to ADMIN_PASSWORD.
# Set it separately so rotating the password does not invalidate live
# sessions, and vice versa.
ADMIN_SESSION_SECRET=

# --- Image storage: Cloudflare R2 ----------------------------------
# STRONGLY RECOMMENDED IN PRODUCTION.
#
# Coolify rebuilds the container from git on every deploy, so an image
# written to the container's filesystem is lost at the next deploy.
# Without R2 the panel still works, but uploads are written to
# public/images/ inside the container and will not survive a redeploy.
# The panel shows a warning in that state.
#
# Create a bucket at https://dash.cloudflare.com → R2, then an API
# token with Object Read & Write. R2_PUBLIC_URL is the bucket's public
# domain (r2.dev or a custom domain), with no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Content commits: GitHub ---------------------------------------
# Without these, text edits are written to the local filesystem only
# and never reach production. With them, saving in the panel commits
# to the repository and Coolify redeploys automatically.
#
# Use a fine-grained token with "Contents: Read and write" on this
# repository only: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main

# --- Deploy: Coolify -------------------------------------------------
# OPTIONAL. Lets the admin panel trigger a rebuild from the masthead, so a save
# does not depend on the push webhook being wired.
#
# Where to find it:
#   Coolify → [application] → Webhooks → Deploy Webhook
#   Copy the full URL, including the `?uuid=...&force=false` query string.
#
# This does NOT replace auto-deploy on push — that still covers edits made
# outside the panel. It covers "I just saved and the site did not change".
COOLIFY_WEBHOOK_URL=

# Only needed if the webhook is protected. Coolify requires a token when the
# endpoint is not reachable on a private network.
#   Coolify → Keys & Tokens → API tokens
COOLIFY_API_TOKEN=
